{
  "name": "research-kb-app-web",
  "private": true,
  "version": "0.1.1b1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint web/src web/tests vite.config.ts playwright.config.ts",
    "test": "vitest run --maxWorkers=4",
    "test:e2e": "playwright test web/tests/e2e/setup.spec.ts && playwright test web/tests/e2e/trusted-parse.spec.ts && playwright test web/tests/e2e/bootstrap.spec.ts && playwright test web/tests/e2e/discovery.spec.ts"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
